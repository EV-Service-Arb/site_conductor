    "/search": {
      "get": {
        "description": "Each kind of source has its own slots, so none crowds out another: the manual (knowledge/structured), the course (lessons and the recordings they link), calls, videos, texts. Within a kind, a passage holding the rarer of the pattern's alternatives ranks first. Each hit gives path:line, its header, its label, the source URL and the lines around it; the files past the slots follow as path:line, for `read`. A pattern hitting most of the scope is refused, with the sub-scopes it hits.\n\nA label is who backs the passage, how they know (ran it, says so, heard it), how sure they were, the information's age, `init`: what it was worth when said, and `norm`: what it is worth today, 0 to 1, higher is better. `unvetted`: nobody of ours has checked the claim. `unscored`: nothing says who speaks.",
        "operationId": "search",
        "parameters": [
          {
            "description": "a regex, case-insensitive; each `|` alternative is scored on its own",
            "in": "query",
            "name": "pattern",
            "required": true,
            "schema": {
              "description": "a regex, case-insensitive; each `|` alternative is scored on its own",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "a path prefix to search under, e.g. `knowledge/references/loom` or `knowledge/structured/profile`",
            "in": "query",
            "name": "scope",
            "schema": {
              "description": "a path prefix to search under, e.g. `knowledge/references/loom` or `knowledge/structured/profile`",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "description": "search what recordings showed on screen instead of what was said",
            "in": "query",
            "name": "screen",
            "schema": {
              "description": "search what recordings showed on screen instead of what was said",
              "type": [
                "boolean",
                "null"
              ]
            },
            "style": "form"
          }
        ],
