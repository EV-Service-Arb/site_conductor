    "/search": {
      "get": {
        "description": "Each kind of source has its own slots, so none crowds out another: knowledge/structured/approved and knowledge/structured/suggested notes, the course (lessons and the recordings they link), calls, videos, texts. Within a kind, a passage holding the rarer of the pattern's alternatives ranks first. Each hit gives path:line, its header, its label, the source URL and the lines around it; the files past the slots follow as path:line, for `read`. A pattern hitting most of the scope is refused, with the sub-scopes it hits.\n\nA label is who said it, their base reliability, the date, and the effective reliability: base plus age, lower is better, 10 at most and as good as nothing. A call's base is its speaker's, so its label gives the age term to add to it instead.\n\nBase by role: 0 tested myself · 1 skool course material or in knowledge/structured/approved/ · 3 a gmbpp member tested it · 4 a gmbpp member claimed it or in knowledge/structured/suggested · 5 a gmbpp member heard or thought of it; a cheap group member tested it · 6 a cheap group member claimed it · 7 a cheap group member heard or thought of it.\nBase by person, whatever their role: 2 Eric · 2 Zach Peterson (youtube `@zachpeters0n`) · 3 Gabe Jacobs (skool `gabe-jacobs-9502`) · 3 Marcus Milan (youtube `@marcusmilxn`) · 3 Matt Gazda (youtube `@Matt_Gazda`).",
        "operationId": "search",
        "parameters": [
          {
            "description": "a regex, case-insensitive; each `|` alternative is scored on its own",
            "in": "query",
            "name": "pattern",
            "required": true,
            "schema": {
              "description": "a regex, case-insensitive; each `|` alternative is scored on its own",
              "type": "string"
            },
            "style": "form"
          },
          {
            "description": "a path prefix to search under, e.g. `knowledge/references/loom` or `knowledge/structured/approved/profile`",
            "in": "query",
            "name": "scope",
            "schema": {
              "description": "a path prefix to search under, e.g. `knowledge/references/loom` or `knowledge/structured/approved/profile`",
              "type": [
                "string",
                "null"
              ]
            },
            "style": "form"
          },
          {
            "description": "search what recordings showed on screen instead of what was said",
            "in": "query",
            "name": "screen",
            "schema": {
              "description": "search what recordings showed on screen instead of what was said",
              "type": [
                "boolean",
                "null"
              ]
            },
            "style": "form"
          }
        ],
