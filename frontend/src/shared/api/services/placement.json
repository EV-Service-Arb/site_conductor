{
  "components": {
    "schemas": {
      "Area": {
        "description": "An area as the conductor keeps it: a city's viewport or a circle, and a margin around it that\nis still \"next to it\".",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "country": {
                "$ref": "#/components/schemas/Country"
              },
              "kind": {
                "const": "city",
                "type": "string"
              },
              "margin_m": {
                "format": "double",
                "type": "number"
              },
              "slug": {
                "type": "string"
              },
              "viewport": {
                "$ref": "#/components/schemas/Viewport"
              }
            },
            "required": [
              "kind",
              "slug",
              "country",
              "viewport",
              "margin_m"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "center": {
                "$ref": "#/components/schemas/LatLng"
              },
              "country": {
                "$ref": "#/components/schemas/Country"
              },
              "kind": {
                "const": "circle",
                "type": "string"
              },
              "margin_m": {
                "format": "double",
                "type": "number"
              },
              "radius_m": {
                "format": "double",
                "type": "number"
              },
              "slug": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "slug",
              "country",
              "center",
              "radius_m",
              "margin_m"
            ],
            "type": "object"
          }
        ]
      },
      "Candidate": {
        "additionalProperties": false,
        "description": "An address the study is actually about. The usual question is \"is *this* one good\", not only\n\"where is best\".",
        "properties": {
          "at": {
            "description": "[lat, lon]",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "at"
        ],
        "type": "object"
      },
      "Category": {
        "additionalProperties": false,
        "description": "A trade set up for a country. `study` names the placement trade that carries what only an\nexpert writes: the demand model, the tier vocabulary, λ.",
        "properties": {
          "country": {
            "$ref": "#/components/schemas/Country"
          },
          "google_additional": {
            "items": {
              "$ref": "#/components/schemas/Gcid"
            },
            "type": "array"
          },
          "google_primary": {
            "$ref": "#/components/schemas/Gcid"
          },
          "keywords": {
            "description": "[`keywords`]' form.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "study": {
            "type": "string"
          },
          "trade": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "trade",
          "country",
          "study",
          "keywords",
          "google_primary",
          "google_additional"
        ],
        "type": "object"
      },
      "Country": {
        "description": "ISO 3166-1 alpha-2, of the countries GBPs are in.",
        "enum": [
          "FR",
          "US",
          "CA",
          "GB"
        ],
        "type": "string"
      },
      "Definition": {
        "additionalProperties": false,
        "properties": {
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ],
            "description": "None is the area on its own: the grid's layers, and not one billed call."
          }
        },
        "required": [
          "area"
        ],
        "type": "object"
      },
      "Error": {
        "description": "Why the request was refused.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "error": {
            "description": "For a person.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "error"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "description": "Which refusal, for a client to act on: its status follows from it.",
        "enum": [
          "bad_request",
          "forbidden",
          "internal",
          "not_found",
          "too_large",
          "unaffordable",
          "unauthenticated",
          "unstudied",
          "csrf",
          "unavailable",
          "bad_gateway"
        ],
        "type": "string"
      },
      "Gcid": {
        "additionalProperties": false,
        "description": "One of Google's Business Profile categories, named in the country's language.",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "LatLng": {
        "properties": {
          "lat": {
            "format": "double",
            "type": "number"
          },
          "lng": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "type": "object"
      },
      "LayerOut": {
        "properties": {
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "scale": {
            "$ref": "#/components/schemas/Scale"
          },
          "values": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "note",
          "scale",
          "values"
        ],
        "type": "object"
      },
      "Notice": {
        "properties": {
          "missing": {
            "description": "Searches the work dir is missing and nobody bought — at least this many. Set when that is\nthe reason.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "missing"
        ],
        "type": "object"
      },
      "Payload": {
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array"
          },
          "center": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "imputed": {
            "items": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "layers": {
            "items": {
              "$ref": "#/components/schemas/LayerOut"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "notice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Notice"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Why the map is less than what was asked for — a spent day of Places quota, or searches the\nwork dir does not hold and this build would not buy."
          },
          "place": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ring": {
            "description": "8 numbers per cell: (lon, lat) SW, SE, NE, NW.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "trade": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Trade"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absent when a location was opened without one. Everything above is the location's, comes out\nof the statistical archive, and costs nothing to ask for."
          },
          "zoom": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "center",
          "zoom",
          "ring",
          "place",
          "imputed",
          "layers",
          "candidates",
          "trade",
          "notice"
        ],
        "type": "object"
      },
      "PoiOut": {
        "description": "Whoever is already selling the service. The inventory that produces one is `gmaps_optimal_placement_sources`.",
        "properties": {
          "addr": {
            "type": "string"
          },
          "fetched_s": {
            "description": "Unix seconds the freshest answer naming it was written. Provenance, like `imputed`: nothing is\nevicted, so without it a map drawn from two-year-old competitors looks like one drawn this morning.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "kind_label": {
            "type": "string"
          },
          "lat": {
            "format": "double",
            "type": "number"
          },
          "lng": {
            "format": "double",
            "type": "number"
          },
          "n_rev": {
            "format": "double",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "seen": {
            "description": "What the probe saw of this business from each of `Payload::nodes`, and nothing modelled: a\ncompetitor's real reach is lumpy and one radial decay cannot say so. Empty alongside `nodes`.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "tel": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "w": {
            "description": "How much this one counts, from `rank`, normalised so the median of its tier is 1.",
            "format": "double",
            "type": "number"
          },
          "web": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "addr",
          "lat",
          "lng",
          "rating",
          "n_rev",
          "kind",
          "kind_label",
          "web",
          "tel",
          "tier",
          "fetched_s",
          "w",
          "seen"
        ],
        "type": "object"
      },
      "QueryOut": {
        "properties": {
          "hits": {
            "description": "Distinct competitors on the map it returned, over every tile. The queries overlap by design.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "hits"
        ],
        "type": "object"
      },
      "Scale": {
        "description": "- `percentile`: Rank, not magnitude — these quantities are heavy-tailed and a linear ramp shows one hot pixel.",
        "enum": [
          "linear",
          "percentile"
        ],
        "type": "string"
      },
      "Served": {
        "description": "What a category may be studied by, and where.",
        "properties": {
          "countries": {
            "description": "The countries a base is served for.",
            "items": {
              "$ref": "#/components/schemas/Country"
            },
            "type": "array"
          },
          "trades": {
            "description": "The trade files a category's `study` names one of.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "trades",
          "countries"
        ],
        "type": "object"
      },
      "TermOut": {
        "properties": {
          "text": {
            "type": "string"
          },
          "weight": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "text",
          "weight"
        ],
        "type": "object"
      },
      "TierOut": {
        "properties": {
          "name": {
            "type": "string"
          },
          "weight": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "name",
          "weight"
        ],
        "type": "object"
      },
      "Trade": {
        "description": "The half of a payload a trade decides, and the whole of the half that is billed. One `Option`\nrather than eight, because a demand surface with no competitors under it is not a state this\ntool has anything to say about.",
        "properties": {
          "demand": {
            "items": {
              "format": "double",
              "type": "number"
            },
            "type": "array"
          },
          "demand_note": {
            "description": "The demand expression itself — the map has no other honest caption for it.",
            "type": "string"
          },
          "lambda_m": {
            "description": "Catchment decay, metres. The map's opening slider position.",
            "format": "double",
            "type": "number"
          },
          "nodes": {
            "description": "Where the probe stood, in the order `PoiOut::seen` is indexed by. Empty until a study has been\nprobed, which is what decides whether the map offers an observed coverage layer at all.",
            "items": {
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "pois": {
            "items": {
              "$ref": "#/components/schemas/PoiOut"
            },
            "type": "array"
          },
          "queries": {
            "description": "The inventory sweep's queries, most competitors on this map first.",
            "items": {
              "$ref": "#/components/schemas/QueryOut"
            },
            "type": "array"
          },
          "searches": {
            "description": "Places searches the inventory sweep was answered with — what re-asking it buys again.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "terms": {
            "description": "The category's keywords and what each is worth: its search volume over the largest. `w` is\nalready scored against them; the what-if needs them because the business it scores does not\nexist yet.",
            "items": {
              "$ref": "#/components/schemas/TermOut"
            },
            "type": "array"
          },
          "tiers": {
            "items": {
              "$ref": "#/components/schemas/TierOut"
            },
            "type": "array"
          },
          "unweighted": {
            "description": "Keywords the volume provider has no data for, so they weigh nothing and are left out.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "lambda_m",
          "demand_note",
          "demand",
          "tiers",
          "terms",
          "unweighted",
          "queries",
          "nodes",
          "pois",
          "searches"
        ],
        "type": "object"
      },
      "Viewport": {
        "properties": {
          "east": {
            "format": "double",
            "type": "number"
          },
          "north": {
            "format": "double",
            "type": "number"
          },
          "south": {
            "format": "double",
            "type": "number"
          },
          "west": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "south",
          "west",
          "north",
          "east"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "placement",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/studies/{sha}": {
      "get": {
        "description": "Built on the first read and kept; never spends. A study whose answers are not all in the work\ndir opens on what it holds, and its notice says how many are missing.",
        "operationId": "study",
        "parameters": [
          {
            "description": "The definition's id: the SHA-256 of its canonical form, hex.",
            "in": "path",
            "name": "sha",
            "required": true,
            "schema": {
              "description": "The definition's id: the SHA-256 of its canonical form, hex.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payload"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`bad_request`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unauthenticated`"
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unaffordable`"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`forbidden`"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`not_found`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unstudied`"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`internal`"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`bad_gateway`"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unavailable`"
          }
        },
        "summary": "A study's payload.",
        "tags": [
          "studies"
        ],
        "x-errors": {
          "bad_gateway": 502,
          "bad_request": 400,
          "csrf": 403,
          "forbidden": 403,
          "internal": 500,
          "not_found": 404,
          "unaffordable": 402,
          "unauthenticated": 401,
          "unavailable": 503,
          "unstudied": 422
        },
        "x-permission": "sa:placement:study:read"
      },
      "put": {
        "description": "Refused unless `sha` is the definition's id and the definition holds: its trade is served, its\ncountry has a base, the trade takes it. Buys nothing.",
        "operationId": "define",
        "parameters": [
          {
            "description": "The definition's id: the SHA-256 of its canonical form, hex.",
            "in": "path",
            "name": "sha",
            "required": true,
            "schema": {
              "description": "The definition's id: the SHA-256 of its canonical form, hex.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Definition"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "no content"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`bad_request`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unauthenticated`"
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unaffordable`"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`forbidden`"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`not_found`"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`too_large`"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unstudied`"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`internal`"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`bad_gateway`"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`unavailable`"
          }
        },
        "summary": "Defines a study.",
        "tags": [
          "studies"
        ],
        "x-errors": {
          "bad_gateway": 502,
          "bad_request": 400,
          "csrf": 403,
          "forbidden": 403,
          "internal": 500,
          "not_found": 404,
          "too_large": 413,
          "unaffordable": 402,
          "unauthenticated": 401,
          "unavailable": 503,
          "unstudied": 422
        },
        "x-permission": "sa:placement:study:read"
      }
    },
    "/studies/{sha}/pull": {
      "post": {
        "description": "Refused `unaffordable` before the first search when the sweep counts past the budget, and\nstopped with it when it outgrows its count. Every answer carries `x-billed`, the searches it\nbought. After a pull that did not end whole, re-asks only what was written before that one began.",
        "operationId": "pull",
        "parameters": [
          {
            "description": "The definition's id: the SHA-256 of its canonical form, hex.",
            "in": "path",
            "name": "sha",
            "required": true,
            "schema": {
              "description": "The definition's id: the SHA-256 of its canonical form, hex.",
              "type": "string"
            },
            "style": "simple"
          },
          {
            "description": "How many Places searches the pull may buy.",
            "in": "query",
            "name": "budget",
            "required": true,
            "schema": {
              "description": "How many Places searches the pull may buy.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payload"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "`bad_request`"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
