{
  "uid": "sa-meters",
  "title": "Vendors' meters \u00b7 everyone",
  "tags": [
    "conductor"
  ],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 39,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "This period, every meter",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "conductor"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "conductor"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/admin/meters",
          "url_options": {
            "method": "GET",
            "params": []
          },
          "root_selector": "$map(meters, function($m) { {\"meter\": $m.name, \"used\": $m.used, \"free\": $m.free, \"left\": $m.left, \"stops\": $m.stop = \"at_free\" ? \"at free\" : \"never\", \"google's count\": $m.baseline, \"as of\": $m.since, \"ours since\": $m.delta, \"synced\": $m.reading = null ? \"never\" : $m.reading.synced_at, \"vendor's cost\": $m.reading = null ? null : $m.reading.cost, \"currency\": $m.reading = null ? null : $m.reading.currency, \"ours since, $\": $m.delta_usd} })",
          "columns": [
            {
              "selector": "meter",
              "text": "meter",
              "type": "string"
            },
            {
              "selector": "used",
              "text": "used",
              "type": "number"
            },
            {
              "selector": "free",
              "text": "free",
              "type": "number"
            },
            {
              "selector": "left",
              "text": "left",
              "type": "number"
            },
            {
              "selector": "stops",
              "text": "stops",
              "type": "string"
            },
            {
              "selector": "google's count",
              "text": "google's count",
              "type": "number"
            },
            {
              "selector": "as of",
              "text": "as of",
              "type": "timestamp"
            },
            {
              "selector": "ours since",
              "text": "ours since",
              "type": "number"
            },
            {
              "selector": "synced",
              "text": "synced",
              "type": "string"
            },
            {
              "selector": "vendor's cost",
              "text": "vendor's cost",
              "type": "number"
            },
            {
              "selector": "currency",
              "text": "currency",
              "type": "string"
            },
            {
              "selector": "ours since, $",
              "text": "ours since, $",
              "type": "number"
            }
          ]
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "left"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "meter": 0,
              "used": 1,
              "free": 2,
              "left": 3,
              "stops": 4,
              "google's count": 5,
              "as of": 6,
              "ours since": 7,
              "synced": 8,
              "vendor's cost": 9,
              "currency": 10,
              "ours since, $": 11
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Used of the free ones",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "conductor"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "conductor"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/admin/meters",
          "url_options": {
            "method": "GET",
            "params": []
          },
          "root_selector": "$map(meters, function($m) { {\"meter\": $m.name, \"used\": $m.used / $m.free * 100} })",
          "columns": [
            {
              "selector": "meter",
              "text": "meter",
              "type": "string"
            },
            {
              "selector": "used",
              "text": "used",
              "type": "number"
            }
          ]
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "displayName": "${__data.fields.meter}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Google's count, at each reading",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "conductor"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "conductor"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "/admin/meters/readings",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "root_selector": "$map(readings, function($r) { {\"at\": $r.synced_at, \"series\": $r.meter, \"units\": $r.units} })",
          "columns": [
            {
              "selector": "at",
              "text": "at",
              "type": "timestamp"
            },
            {
              "selector": "series",
              "text": "series",
              "type": "string"
            },
            {
              "selector": "units",
              "text": "units",
              "type": "number"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "prepareTimeSeries",
          "options": {
            "format": "multi"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "axisLabel": "units"
          },
          "unit": "none",
          "decimals": 0,
          "displayName": "${__field.labels.series}"
        },
        "overrides": []
      }
    }
  ]
}
